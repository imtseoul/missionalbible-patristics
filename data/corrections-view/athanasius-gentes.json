[{"work_id":"athanasius-gentes","location":"1","corrections":[{"before":"διδασκάλων εἰς διδασκάλων ταῦτα","after":"διδασκάλων εἰς ταῦτα","reason":"전자판에서 반복된 διδασκάλων을 제거. PG 25, 4열의 해당 문장은 이 단어를 한 번만 인쇄한다.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n284/mode/1up"},{"before":"οἷς ἐάν τις ταῦτα ἐντύχοι","after":"οἷς ἐάν τις ἐντύχοι","reason":"전자판에 중복 삽입된 ταῦτα를 제거. PG 25, 4열의 해당 문장에는 이 단어가 없다.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n284/mode/1up"}]},{"work_id":"athanasius-gentes","location":"2","corrections":[{"before":"ἈδὰμἈδὰμ","after":"Ἀδὰμ","reason":"persName 안과 뒤에서 중복된 이름 제거. PG 25, 8열에는 Ἀδὰμ이 한 번만 인쇄되어 있다.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n286/mode/1up"}]},{"work_id":"athanasius-gentes","location":"5","corrections":[{"before":"μέλη ὅθεν","after":"ὅθεν","reason":"잘못 삽입된 μέλη 제거. 인쇄12열에서는 ὅθεν으로 다음 문장이 시작된다.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n288/mode/1up"}]},{"work_id":"athanasius-gentes","location":"9","corrections":[{"before":"ἀνύμνησανκαὶ.","after":"ἀνύμνησαν.","reason":"전자판 단어 뒤의 잘못 삽입된 καὶ 제거. 인쇄17열의 문장 끝을 확인.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n291/mode/1up"},{"before":"τὸν τοῦ Χριστοῦ εἰς πατέρα","after":"τὸν τοῦ Χριστοῦ πατέρα","reason":"전자판의 잘못 삽입된 εἰς 제거. 인쇄20열은 τοῦ Χριστοῦ Πατέρα.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n292/mode/1up"},{"before":"οἷός ἐστιν ὁ ὁ παρ’","after":"οἷός ἐστιν ὁ παρ’","reason":"관사 중복 제거. 인쇄20열 확인.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n292/mode/1up"},{"before":"κρίνωσι, κρίνωσι ἐν","after":"κρίνωσι ἐν","reason":"중복 동사 제거. 인쇄20열에 동일 동사의 연속 반복은 없다. 다른 판본의 δογματίζουσιν 독법은 합치지 않음.","evidence_url":"https://archive.org/stream/patrologicursus78migngoog#page/n292/mode/1up"},{"before":"πολεμίους πολεμίους","after":"πολεμίους","reason":"중복 단어 제거. 인쇄21열 확인.","evidence_url":"